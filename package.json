{
  "name": "n8n-nodes-shopiza",
  "version": "0.1.0",
  "description": "n8n nodes for Shopiza: trigger on new orders, payments, products and customers, and read or update orders, products and stock.",
  "keywords": [
    "n8n-community-node-package",
    "shopiza",
    "ecommerce",
    "webshop",
    "orders"
  ],
  "license": "MIT",
  "homepage": "https://shopiza.io/developers",
  "author": {
    "name": "Shopiza",
    "email": "hello@shopiza.io"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && node scripts/copy-icons.js",
    "test": "node test/run.js"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/ShopizaApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Shopiza/Shopiza.node.js",
      "dist/nodes/Shopiza/ShopizaTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "20.17.6",
    "n8n-workflow": "2.16.0",
    "typescript": "5.6.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
