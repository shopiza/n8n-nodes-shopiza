{
  "name": "n8n-nodes-shopiza",
  "version": "0.2.0",
  "description": "n8n nodes for Shopiza: trigger on new orders, payments, products and customers, and read or update orders, products and stock.",
  "keywords": [
    "n8n-community-node-package",
    "shopiza",
    "ecommerce",
    "webshop",
    "orders"
  ],
  "license": "MIT",
  "homepage": "https://shopiza.io/developers",
  "author": {
    "name": "Shopiza",
    "email": "hello@shopiza.io"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/shopiza/n8n-nodes-shopiza.git"
  },
  "bugs": {
    "url": "https://github.com/shopiza/n8n-nodes-shopiza/issues"
  },
  "main": "index.js",
  "scripts": {
    "build": "n8n-node build",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease",
    "test": "node test/run.js"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/ShopizaApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Shopiza/Shopiza.node.js",
      "dist/nodes/Shopiza/ShopizaTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "0.56.2",
    "@types/node": "20.17.6",
    "eslint": "9.32.0",
    "n8n-workflow": "2.16.0",
    "prettier": "3.6.2",
    "release-it": "19.2.4",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
